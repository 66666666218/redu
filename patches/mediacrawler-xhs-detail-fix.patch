+def _make_retry_error() -> RetryError:
+    """造一个**真的** RetryError(让 tenacity 自己跑出来,不手搓它的内部结构)。"""
+    from tenacity import retry, stop_after_attempt, wait_fixed
+
+    @retry(stop=stop_after_attempt(1), wait=wait_fixed(0))
+    def _boom():
+        raise ValueError("extractor blew up(新版详情页 state 含 JS 字面量)")
+
+    try:
+        _boom()
+    except RetryError as exc:
+        return exc
+    raise AssertionError("应当抛出 RetryError")
+
+
+@pytest.mark.asyncio
+async def test_html_fallback_retry_error_skips_note():
+    """2026-10-04:HTML 兜底重试耗尽时必须**跳过该条**,不能拖垮整批。
+
+    真因见 doc/operations.md §4n:新版小红书详情页的 `window.__INITIAL_STATE__` 含
+    JS 字面量 `new Map([])`,extractor 用 json.loads 解析**整段** state 时整段崩 →
+    RetryError 冒泡 → 此前无人接住,20 条笔记一起丢(整轮退出码 1、零产出)。
+
+    反向验证:把 core.py 里那段 try/except RetryError 摘掉,本测试立刻变红。
+    """
+    xhs_client = AsyncMock()
+    xhs_client.get_note_by_id.return_value = None  # API 路径没拿到 → 走 HTML 兜底
+    xhs_client.get_note_by_id_from_html.side_effect = _make_retry_error()
+
+    result = await make_crawler(xhs_client).get_note_detail_async_task(
+        note_id="n1",
+        xsec_source="pc_search",
+        xsec_token="token",
+        semaphore=asyncio.Semaphore(1),
+    )
+
+    assert result is None
