# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行产物
data/
*.db
.snapshots/

# 微信小程序产物(逆向参考,不入库)
doc/js/

# 前端构建产物(由 Docker 多阶段构建生成,不入库)
app/static/spa/
node_modules/

# 抓包探测产物(含请求头敏感信息)
*_captured.json

# 环境与密钥
# 连同 .env.bak / .env.local / .env.prod 等一并忽略——这些副本同样含真实
# Cookie、SMTP 授权码与代理密钥,只写 `.env` 会让备份文件漏网。
.env
.env.*
!.env.example

# 编辑器/系统
.idea/
.vscode/
.DS_Store
