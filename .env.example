# 复制为 .env 并填写真实值;.env 已被 .gitignore 忽略。

# ---- 平台(多租户) ----
JWT_SECRET=please_set_a_long_random_secret_here      # 必填,强随机
JWT_EXPIRE_MINUTES=604800                           # 登录有效期(7 天)
COOKIE_ENCRYPT_KEY=                                  # 可选,Cookie 加密密钥(Fernet);留空则用 JWT_SECRET 派生
DATABASE_URL=mysql+pymysql://redu:redu@mysql:3306/redu?charset=utf8mb4
MYSQL_ROOT_PASSWORD=redu_root_change_me              # docker-compose 里 MySQL root 密码
PUBLIC_BASE_URL=http://localhost:8080                # 站点对外地址(重置链接等)
ADMIN_EMAIL=                                         # 用该邮箱注册即自动成为管理员(逗号分隔可多值)

# ---- 采集 ----
USE_PROXY=false
PROXY_URL=
PROXY_USER=
PROXY_PASS=
# 提取式代理池(巨量IP getips 完整 URL,含 trade_no/sign)。设置后自动走代理池,忽略上面静态隧道。
PROXY_EXTRACT_URL=
PROXY_REFRESH_SECONDS=170
WEIBO_COOKIE=
BAIDU_COOKIE=

# ---- 闲鱼热榜(虚拟商品) ----
GOOFISH_COOKIE_FILE=data/goofish_cookie.txt   # 闲鱼 Cookie 文件(gitignored)
XIANYU_KEYWORDS=ps教程,网盘资源,代充,剪映会员,软件,素材,cad,ae,pr,office,会员,课程,影视,源码
XIANYU_TOP_N=100               # 前 N 虚拟商品榜(搜索级)
XIANYU_DETAIL_LIMIT=20         # 慢速抓详情(想要数)的商品数

# ---- 抖音热点·内容词趋势 ----
DOUHOT_COOKIE_FILE=data/douhot_cookie.txt   # 抖音热点宝 Cookie 文件(gitignored)
DOUHOT_TOP_N=50
DOUHOT_ALERT_MAX=5               # 单次判涨告警上限(防刷屏)
DOUHOT_ALERT_COOLDOWN_HOURS=24   # 同一内容词告警冷却(小时)

# ---- 分析阈值 ----
GROWTH_THRESHOLD=0.30
SLOPE_THRESHOLD=0.0
MIN_HEAT=200000
TOP_N=10
MIN_SAMPLES=3

# ---- 指数源 ----
MOCK_INDEX=true          # true=用合成指数源,免真实抓取;生产改为 false
INDEX_SOURCES=weibo      # weibo=多轮微博热度序列(推荐)/douyin/baidu,顺序即优先级

# ---- 交叉验证/告警模式 ----
ALERT_MODE=both          # both=所有信号源同涨才告警; any=任一源涨即告警

# ---- 调度 ----
# 采集频率由每个用户在「采集频率」页自行设置(10~1440 分钟),无全局 Cron。
# 调度器随 API 进程启动;若用 uvicorn --workers N 多进程部署,必须设为 false 并单起调度容器,否则会重复采集。
SCHEDULER_ENABLED=true
REQUEST_DELAY_SECONDS=2.5      # 每次外部请求间的随机间隔(秒)

# ---- 飞书机器人(每天 08:00 日报 + 实时热点推送)----
# webhook 为空时每日日报与实时提醒自动关闭;secret 仅当机器人开启"签名校验"时必填。
FEISHU_WEBHOOK=
FEISHU_SECRET=
FEISHU_DAILY_CRON=0 8 * * *        # 每日热点日报时间(默认每天 08:00)
FEISHU_HOT_RANK_JUMP=3             # 排名跳升 >= 该名次即实时推送
FEISHU_HOT_RATIO=0.30              # 分值环比涨幅 >= 该比例即实时推送
FEISHU_ALERT_COOLDOWN_HOURS=6      # 同一话题实时推送冷却(小时),防刷屏

# ---- 抖音热点宝直连/代理 ----
# 部分服务器 IP 会被抖音风控(直连返回 502 nginx),服务器上建议设 true,
# 让 douhot 采集走 PROXY_EXTRACT_URL 提取的住宅代理池(需该代理可用)。
DOUHOT_USE_PROXY=false

# ---- 邮件通知 ----
IS_DEV=true              # true=不真正外发邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=热点监控
NOTIFY_TO=

# ---- 服务 ----
APP_PORT=8080
DATA_DIR=data
