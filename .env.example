# 复制为 .env 并填写真实值;.env 已被 .gitignore 忽略。

# ---- 平台(多租户) ----
JWT_SECRET=please_set_a_long_random_secret_here      # 必填,强随机
JWT_EXPIRE_MINUTES=604800                           # 登录有效期(7 天)
COOKIE_ENCRYPT_KEY=                                  # 可选,Cookie 加密密钥(Fernet);留空则用 JWT_SECRET 派生
DATABASE_URL=mysql+pymysql://redu:redu@mysql:3306/redu?charset=utf8mb4
MYSQL_ROOT_PASSWORD=redu_root_change_me              # docker-compose 里 MySQL root 密码
PUBLIC_BASE_URL=http://localhost:8080                # 站点对外地址(重置链接等)
ADMIN_EMAIL=                                         # 用该邮箱注册即自动成为管理员(逗号分隔可多值)

# ---- 采集 ----
USE_PROXY=false
PROXY_URL=
PROXY_USER=
PROXY_PASS=
# 提取式代理池(巨量IP getips 完整 URL,含 trade_no/sign)。设置后自动走代理池,忽略上面静态隧道。
PROXY_EXTRACT_URL=
PROXY_REFRESH_SECONDS=170
WEIBO_COOKIE=
BAIDU_COOKIE=

# ---- 闲鱼热榜(虚拟商品) ----
GOOFISH_COOKIE_FILE=data/goofish_cookie.txt   # 闲鱼 Cookie 文件(gitignored)
XIANYU_KEYWORDS=ps教程,网盘资源,代充,剪映会员,软件,素材,cad,ae,pr,office,会员,课程,影视,源码
XIANYU_TOP_N=100               # 前 N 虚拟商品榜(搜索级)
XIANYU_DETAIL_LIMIT=10         # 慢速抓详情(想要数)的商品数(压低防风控)
XIANYU_REQUEST_DELAY=8.0        # 闲鱼相邻请求间隔(秒,带抖动);防 mtop 风控,嫌快就放大
XIANYU_BATCH_KEYWORDS=5         # 每次采集最多处理的关键词数(少量多次,按运行数轮转覆盖全部)
XIANYU_PROXY_URL=               # 闲鱼专用固定出口代理(http://user:pass@host:port,如住宅IP);留空直连。勿用轮换代理池(token/session 绑 IP)

# ---- 抖音热点·内容词趋势 ----
DOUHOT_COOKIE_FILE=data/douhot_cookie.txt   # 抖音热点宝 Cookie 文件(gitignored)
DOUHOT_TOP_N=100
DOUHOT_ALERT_MAX=5               # 单次判涨告警上限(防刷屏)
DOUHOT_ALERT_COOLDOWN_HOURS=24   # 同一内容词告警冷却(小时)

# ---- 分析阈值 ----
GROWTH_THRESHOLD=0.30
SLOPE_THRESHOLD=0.0
MIN_HEAT=200000
TOP_N=10
MIN_SAMPLES=3

# ---- 指数源 ----
MOCK_INDEX=true          # true=用合成指数源,免真实抓取;生产改为 false
INDEX_SOURCES=weibo      # weibo=多轮微博热度序列(推荐)/douyin/baidu,顺序即优先级

# ---- 交叉验证/告警模式 ----
ALERT_MODE=both          # both=所有信号源同涨才告警; any=任一源涨即告警

# ---- 调度 ----
# 采集频率由每个用户在「采集频率」页自行设置(10~1440 分钟),无全局 Cron。
# 调度器随 API 进程启动;若用 uvicorn --workers N 多进程部署,必须设为 false 并单起调度容器,否则会重复采集。
SCHEDULER_ENABLED=true
REQUEST_DELAY_SECONDS=2.5      # 每次外部请求间的随机间隔(秒)
FAIL_ALERT_THRESHOLD=3         # 某用户某板块近24h失败>=该次数→推飞书告警(防Cookie过期无人知)
HEALTH_STALL_HOURS=24         # 某在用平台超过该小时数无新数据写入→推飞书(防静默停摆:后端宕机/调度停/被风控全挡)
HEALTH_ESCALATE_DAYS=3        # 停摆/失败连续超过该天数→标注【长期】建议人工排查(区分偶发与长期坏)
DATA_RETENTION_DAYS=30         # 数据保留天数,超期快照/运行/告警/日志每天04:00清理

# ---- 飞书机器人(每天 08:00 日报 + 实时热点推送)----
# webhook 为空时每日日报与实时提醒自动关闭;secret 仅当机器人开启"签名校验"时必填。
FEISHU_WEBHOOK=                       # 总群机器人 Webhook(板块推送未配专属群时回落这里)
FEISHU_WEBHOOK_WEIBO=                 # 微博专属群 Webhook(非空则微博监控推到这里)
FEISHU_WEBHOOK_XIANYU=                # 闲鱼专属群 Webhook
FEISHU_WEBHOOK_DOUHOT=                # 抖音专属群 Webhook
FEISHU_WEBHOOK_BAIDU=                 # 百度专属群 Webhook
FEISHU_WEBHOOK_WECHAT=                # 公众号专属群 Webhook(内容选题分析提醒)

# ---- 公众号监听/同步(大家拉/极致了数据,见 doc/dajiala-api.md) ----
DAJIALA_KEY=                    # API key(形如 JZLxxxx);留空=公众号监听/同步停用
WEREAD_COOKIE=                  # 微信读书 Cookie(免费监听源,推荐在平台「Cookie管理」按用户配置);与 DAJIALA_KEY 至少配一个
WECHAT_READER_PLATFORM_URL=     # 读书平台地址(wewe-rss v2 兼容实例,免费全量文章列表,首选源);留空停用
WECHAT_READER_TOKEN=            # 读书平台 token(含 vid 的 JWT,三段式)
WECHAT_READER_VID=              # 读书平台 vid(微信读书用户ID)
WECHAT_LISTEN_SAMPLE_NEW=true   # 监听到新文时立即采样阅读量(随推送一起发飞书)
WECHAT_LISTEN_SAMPLE_LIMIT=10   # 监听一轮内即时采样的新文上限(¥0.06/篇)
QUARK_COOKIE=                   # 夸克网盘 Cookie(pan.quark.cn 登录后复制);用于自动转存对标文的分享链
QUARK_SAVE_DIR=/redian监听       # 转存目标目录(自动逐级创建)
QUARK_SHARE_PASSWORD=           # 二次分享提取码(空=无)
PAN_TRANSFER_ENABLED=true       # 自动转存开关(需 QUARK_COOKIE;转存失败回落原链接推送)
DAJIALA_MIN_BALANCE=1.0         # 余额低于该值(元)跳过付费监听,防止打穿余额
WECHAT_SYNC_MAX_PAGES=3         # 一键同步默认最多翻页数(¥0.14/页,每页约10次发文)
FEISHU_WECHAT_CRON=0 10 * * *        # 公众号内容选题分析推送时间(默认 10:00)
FEISHU_SECRET=
FEISHU_DAILY_CRON=0 8 * * *        # 每日热点日报时间(默认每天 08:00)
FEISHU_HOT_RANK_JUMP=3             # 排名跳升 >= 该名次即实时推送
FEISHU_HOT_RATIO=0.30              # 分值环比涨幅 >= 该比例即实时推送
FEISHU_BURST_MIN_CONFIDENCE=高    # 实时推送"预测爆发"所需最低置信度(高/中/低);中低只进日报与洞察、不实时推
FEISHU_ALERT_COOLDOWN_HOURS=6      # 同一话题实时推送冷却(小时),防刷屏
FEISHU_INSIGHT_CRON=0 9 * * 1     # 每周一 09:00 推"近7天爆点回顾"(智能体洞察报告)
WEEKLY_SUMMARY_CRON=0 20 * * 0    # 每周日 20:00 给每个用户发"本周热点洞察"邮件(需配置 SMTP)

# ---- 抖音热点宝直连/代理 ----
# 部分服务器 IP 会被抖音风控(直连返回 502 nginx),服务器上建议设 true,
# 让 douhot 采集走 PROXY_EXTRACT_URL 提取的住宅代理池(需该代理可用)。
DOUHOT_USE_PROXY=false

# ---- 邮件通知 ----
IS_DEV=true              # true=不真正外发邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=热点监控
NOTIFY_TO=

# ---- 服务 ----
APP_PORT=8080
DATA_DIR=data
