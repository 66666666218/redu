# 复制为 .env 并填写真实值;.env 已被 .gitignore 忽略。

# ---- 采集 ----
USE_PROXY=false
PROXY_URL=
PROXY_USER=
PROXY_PASS=
WEIBO_COOKIE=
BAIDU_COOKIE=

# ---- 分析阈值 ----
GROWTH_THRESHOLD=0.30
SLOPE_THRESHOLD=0.0
MIN_HEAT=200000
TOP_N=10
MIN_SAMPLES=3

# ---- 指数源 ----
MOCK_INDEX=true          # true=用合成指数源,免真实抓取;生产改为 false
INDEX_SOURCES=weibo      # weibo=多轮微博热度序列(推荐)/douyin/baidu,顺序即优先级

# ---- 调度 ----
JOB_CRON=*/30 * * * *

# ---- 邮件通知 ----
IS_DEV=true              # true=不真正外发邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=

# ---- 服务 ----
APP_PORT=8080
DATA_DIR=data
